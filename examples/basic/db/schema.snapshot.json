{
  "dialect": "postgresql",
  "namespaces": [
    {
      "name": "billing"
    }
  ],
  "extensions": [
    {
      "name": "pgcrypto"
    }
  ],
  "enums": [
    {
      "schema": "billing",
      "name": "invoice_status",
      "values": [
        "draft",
        "issued",
        "paid",
        "void"
      ]
    }
  ],
  "compositeTypes": [
    {
      "schema": "billing",
      "name": "money",
      "attributes": [
        {
          "name": "amount",
          "type": "numeric(10, 2)"
        },
        {
          "name": "currency",
          "type": "char(3)"
        }
      ]
    }
  ],
  "domains": [
    {
      "name": "email",
      "baseType": "text",
      "notNull": true,
      "check": "value ~ '^[^@]+@[^@]+$'"
    }
  ],
  "sequences": [
    {
      "schema": "billing",
      "name": "order_number_seq",
      "increment": 1,
      "startWith": 1000,
      "cache": 1
    }
  ],
  "tables": [
    {
      "schema": "billing",
      "name": "invoice_lines",
      "columns": [
        {
          "name": "invoice_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "line_no",
          "type": "integer",
          "notNull": true
        },
        {
          "name": "description",
          "type": "text",
          "notNull": true
        },
        {
          "name": "amount_cents",
          "type": "integer",
          "notNull": true
        }
      ],
      "primaryKeys": [
        {
          "name": "invoice_lines_pkey",
          "columns": [
            "invoice_id",
            "line_no"
          ]
        }
      ],
      "foreignKeys": [
        {
          "name": "invoice_lines_invoice_id_fkey",
          "referencedTable": "billing.invoices",
          "onDelete": "cascade",
          "columns": [
            "invoice_id"
          ],
          "referencedColumns": [
            "id"
          ]
        }
      ],
      "checks": [
        {
          "name": "invoice_lines_amount_cents_positive",
          "expression": "amount_cents \u003e 0"
        }
      ],
      "indexes": [
        {
          "with": {
            "fillfactor": "90"
          },
          "name": "invoice_lines_description_idx",
          "method": "btree",
          "columns": [
            {
              "expression": "description",
              "opClass": "text_ops"
            }
          ],
          "concurrently": true
        }
      ]
    },
    {
      "schema": "billing",
      "name": "invoices",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "default": "gen_random_uuid()",
          "primaryKey": true
        },
        {
          "name": "user_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "amount_cents",
          "type": "integer",
          "notNull": true
        },
        {
          "name": "status",
          "type": "billing.invoice_status",
          "default": "'draft'",
          "notNull": true
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "default": "now()",
          "notNull": true
        }
      ],
      "foreignKeys": [
        {
          "name": "invoices_user_id_fkey",
          "referencedTable": "public.users",
          "onDelete": "cascade",
          "initially": "DEFERRED",
          "columns": [
            "user_id"
          ],
          "referencedColumns": [
            "id"
          ],
          "deferrable": true
        }
      ],
      "checks": [
        {
          "name": "invoices_amount_cents_positive",
          "expression": "amount_cents \u003e 0"
        }
      ],
      "indexes": [
        {
          "name": "invoices_user_id_created_at_idx",
          "where": "status \u003c\u003e 'void'",
          "columns": [
            {
              "expression": "user_id"
            },
            {
              "expression": "created_at",
              "order": "DESC",
              "nulls": "LAST"
            }
          ]
        }
      ]
    },
    {
      "name": "bookings",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "default": "gen_random_uuid()",
          "primaryKey": true
        },
        {
          "name": "resource",
          "type": "text",
          "notNull": true
        },
        {
          "name": "owner",
          "type": "text",
          "notNull": true
        },
        {
          "name": "during",
          "type": "tstzrange",
          "notNull": true
        }
      ],
      "exclusions": [
        {
          "name": "bookings_no_overlap",
          "method": "gist",
          "elements": [
            {
              "expression": "during",
              "operator": "\u0026\u0026"
            }
          ]
        }
      ]
    },
    {
      "name": "events",
      "columns": [
        {
          "identity": {
            "name": "events_id_seq",
            "type": "always",
            "increment": 1,
            "cache": 20
          },
          "name": "id",
          "type": "integer",
          "notNull": true
        },
        {
          "name": "description",
          "type": "text",
          "notNull": true
        },
        {
          "generated": {
            "as": "to_tsvector('english', description)",
            "type": "stored"
          },
          "name": "search_vector",
          "type": "text"
        },
        {
          "name": "metadata",
          "type": "jsonb",
          "default": "'{\"source\":\"api\"}'::jsonb"
        },
        {
          "name": "payload",
          "type": "bytea"
        },
        {
          "name": "duration",
          "type": "interval day to second (6)",
          "notNull": true
        },
        {
          "name": "priority",
          "type": "smallint",
          "default": "0",
          "notNull": true
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "default": "now()",
          "notNull": true
        }
      ],
      "indexes": [
        {
          "name": "events_priority_created_at_idx",
          "columns": [
            {
              "expression": "priority"
            },
            {
              "expression": "created_at"
            }
          ]
        }
      ]
    },
    {
      "name": "users",
      "comment": "Application users.",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "default": "gen_random_uuid()",
          "primaryKey": true
        },
        {
          "name": "email",
          "type": "text",
          "notNull": true
        },
        {
          "name": "display_name",
          "type": "text"
        },
        {
          "name": "last_login_ip",
          "type": "inet"
        },
        {
          "name": "tags",
          "type": "text[]"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "default": "now()",
          "notNull": true
        }
      ],
      "uniqueConstraints": [
        {
          "name": "users_email_unique",
          "columns": [
            "email"
          ]
        }
      ]
    }
  ],
  "version": 1
}
